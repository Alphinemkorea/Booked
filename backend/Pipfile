[requires]
python_version = "3.11"

[pipenv]
allow_prereleases = false

[scripts]
dev = "flask run --debug --host=0.0.0.0 --port=5000"
test = "pytest -v --cov=backend --cov-report=html"
test-watch = "ptw"
lint = "flake8 backend/ && pylint backend/"
format = "black backend/ && isort backend/"
migrate = "flask db migrate"
upgrade = "flask db upgrade"
downgrade = "flask db downgrade"
seed = "python -m backend.seed"
shell = "flask shell"